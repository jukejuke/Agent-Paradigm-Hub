# ============================================
# AI Agent Paradigm Hub - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ============================================

# --- OpenAI 配置 ---
OPENAI_API_KEY=your-openai-api-key-here
# 可选：自定义 API 端点（支持兼容 OpenAI 协议的服务）
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic 配置 ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# --- Agent Plan（火山方舟 · 豆包 Seedream 图像生成）---
# Agent Plan 专属 API Key（非方舟普通 API Key，获取于 Agent Plan 配置页）
# AGENT_PLAN_API_KEY=your-agent-plan-api-key-here

# --- Agnes Image 2.5 Flash（OpenAI 兼容接口，与上方 Agent Plan 相互独立）---
# Agnes API Key（https://agnes-ai.com 控制台获取）
# AGNES_API_KEY=your-agnes-api-key-here
# 可选：自定义 API 地址，默认 https://apihub.agnes-ai.com/v1（国内节点可换 .cn）
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# --- 默认配置 ---
# 默认使用的提供商: openai 或 anthropic
DEFAULT_PROVIDER=openai
# 默认模型温度 (0.0 - 2.0)
DEFAULT_TEMPERATURE=0.7
# 最大 token 数
DEFAULT_MAX_TOKENS=4096
